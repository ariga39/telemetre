# Centre-side environment. Copy to /etc/telemetre/center.env.
# The centre runs only the telemetre service user; source collectors and quota
# samplers run as their normal logged-in users.
CENTER_DB=/var/lib/telemetre/center.sqlite3
BACKUP_DIR=/var/backups/telemetre
QUOTA_CENTER_CONFIG=/etc/telemetre/quota-center.json
EXPECTED_USAGE=alpha:personal@example.test
EXPECTED_QUOTA_AGY=alpha:agy:personal@example.test
EXPECTED_QUOTA_CODEX=alpha:codex:personal@example.test
MAX_AGE_SECONDS=7200
