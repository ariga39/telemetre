# Source-side user environment. Copy to ~/.config/telemetre/telemetre.env.
# Paths and public identifiers only; never store private keys or provider
# credentials here. Each binding has its own SSH key.
MACHINE=alpha
ACCOUNT=personal@example.test
BINDING_ID_USAGE=alpha-usage
BINDING_ID_QUOTA_AGY=alpha-quota-agy
BINDING_ID_QUOTA_CODEX=alpha-quota-codex
SSH_HOST=centre.example.test
SSH_USER=telemetre
