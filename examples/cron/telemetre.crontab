# Source user crontab (not root). Each binding has its own key; each provider
# send is independent so one failure does not block the other.
# The source user must keep its agy/Codex login and writable home intact.
SHELL=/bin/sh
PATH=/home/alpha/.local/bin:/usr/local/bin:/usr/bin:/bin

# agy usage: collect, then deliver.
7 * * * * cd /opt/telemetre && PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.delivery run --lock "$XDG_RUNTIME_DIR/telemetre/collect.lock" --timeout 900 -- /usr/bin/python3 -m telemetre collect --client-db "$HOME/.local/state/telemetre/client.sqlite3" --machine alpha --account personal@example.test --root "$HOME/.gemini/antigravity-cli" && PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.delivery run --lock "$XDG_RUNTIME_DIR/telemetre/delivery.lock" --timeout 300 -- /usr/bin/python3 -m telemetre.delivery send --client-db "$HOME/.local/state/telemetre/client.sqlite3" --bindings "$HOME/.config/telemetre/bindings.json" --binding-id alpha-usage --ssh-host centre.example.test --ssh-user telemetre --identity "$HOME/.ssh/telemetre_usage" --known-hosts "$HOME/.ssh/telemetre_known_hosts"

# Quota: sample both providers, then deliver each provider on its own key.
*/15 * * * * cd /opt/telemetre && PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.quota sample --config "$HOME/.config/telemetre/quota.json" --if-due; PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.delivery run --lock "$XDG_RUNTIME_DIR/telemetre/quota-agy.lock" --timeout 300 -- /usr/bin/python3 -m telemetre.delivery send-quota --quota-db "$HOME/.local/state/telemetre/quota.sqlite3" --bindings "$HOME/.config/telemetre/bindings.json" --binding-id alpha-quota-agy --ssh-host centre.example.test --ssh-user telemetre --identity "$HOME/.ssh/telemetre_quota_agy" --known-hosts "$HOME/.ssh/telemetre_known_hosts"; PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.delivery run --lock "$XDG_RUNTIME_DIR/telemetre/quota-codex.lock" --timeout 300 -- /usr/bin/python3 -m telemetre.delivery send-quota --quota-db "$HOME/.local/state/telemetre/quota.sqlite3" --bindings "$HOME/.config/telemetre/bindings.json" --binding-id alpha-quota-codex --ssh-host centre.example.test --ssh-user telemetre --identity "$HOME/.ssh/telemetre_quota_codex" --known-hosts "$HOME/.ssh/telemetre_known_hosts"

# Centre crontab (user telemetre): daily digest for yesterday in the configured
# timezone (no --date), then daily backup and health checks.
17 0 * * * cd /opt/telemetre && PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.quota daily --config /etc/telemetre/quota-center.json --db /var/lib/telemetre/center.sqlite3 --json
27 3 * * * cd /opt/telemetre && PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.delivery backup --center-db /var/lib/telemetre/center.sqlite3 --dest /var/backups/telemetre
*/30 * * * * cd /opt/telemetre && PYTHONPATH=/opt/telemetre /usr/bin/python3 -m telemetre.delivery check --center-db /var/lib/telemetre/center.sqlite3 --expect-usage alpha:personal@example.test --expect-quota alpha:agy:personal@example.test --expect-quota alpha:codex:personal@example.test --max-age-seconds 7200 --format json
